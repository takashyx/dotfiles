// VSCode ユーザー設定 (OS 共通)
//   %APPDATA%\Code\User\settings.json (Windows)
//   ~/Library/Application Support/Code/User/settings.json (Mac)
//   へリンクされる。VSCode の GUI から設定を変更するとこのファイルが書き換わるので、
//   差分が出たらそのままコミットすればよい。
{
    "claudeCode.preferredLocation": "panel",
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "nvim-ui.nvimColorCustomizationKeys": [
        "tab.activeBorder",
        "editorCursor.foreground",
        // "activityBarBadge.background",
        // "inputValidation.errorBorder",
        "panel.border",
        // "panelTitle.activeBorder",
        // "panelTitle.activeForeground",
        // "peekView.border",
        // "peekViewTitleLabel.foreground",
        "tab.activeBorder",
        // "statusBar.border",
        "statusBar.background",
        "activityBar.background"
    ],
    "workbench.colorTheme": "Best Themes - One Dark Pro",
    "editor.renderLineHighlight": "all",
    "git.autofetch": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "nvim-ui.nvimColorNormal": "#404040",
    "nvim-ui.nvimColorReplace": "#909000",
    "nvim-ui.nvimColorInsert": "#A03000",
    // フォントは setup.sh / setup.ps1 が自動インストールする (Moralerspace Neon HW)
    "editor.fontFamily": "'Moralerspace Neon HW', monospace",
    "editor.fontLigatures": "true",
    "workbench.colorCustomizations": {
        "tab.activeBorder": "#404040",
        "editorCursor.foreground": "#404040",
        "panelTitle.activeBorder": "#404060",
        "statusBar.background": "#404040",
        "activityBar.background": "#404040",
        "panel.border": "#404040"
    }
}
